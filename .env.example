# =========================================================================
# VITASTA SAREE ATELIER - ENVIRONMENT SECRETS TEMPLATE (.env.example)
# =========================================================================
# Copy this file to .env or configure in your deployment platform (Netlify / Vercel).

# 1. Database Connection (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:YOUR_DATABASE_PASSWORD@ep-sample-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&schema=vitasta"

# 2. Better Auth Configuration
BETTER_AUTH_SECRET="YOUR_GENERATED_32_CHAR_BETTER_AUTH_SECRET"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# 4. Cloudinary CDN & Asset Pipeline
CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"

# 5. Razorpay Online Payment Gateway
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

# 6. Feature Flags
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="true"

# 7. Initial Admin Seed Credentials (Optional - Used during auto-initialization)
ADMIN_EMAIL="admin@vitasta.com"
ADMIN_PASSWORD="password123"
ADMIN_NAME="Smita Saraswat"
ADMIN_PHONE="+91 88240 17443"
