{
  "name": "vitasta-saree-atelier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./*"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node --max-http-header-size=65536 node_modules/next/dist/bin/next dev",
    "db:init": "node scripts/init-db.mjs",
    "build:pdf": "python scripts/build_pdf.py",
    "build": "node scripts/init-db.mjs && prisma generate && next build",
    "start": "node --max-http-header-size=65536 node_modules/next/dist/bin/next start",
    "serve": "npx serve -l 3000 .",
    "test": "node --loader ./test_loader.mjs --env-file=.env test_suite.mjs",
    "test:deep": "node --loader ./test_loader.mjs --env-file=.env test_deep_dive.mjs",
    "test:endpoints": "node test_endpoints.mjs",
    "lint": "eslint",
    "seed": "node --env-file=.env prisma/seed.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.23",
    "cloudinary": "^2.10.0",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "nextjs-toploader": "^3.9.17",
    "razorpay": "^2.9.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.0.0"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "16.2.10",
    "@next/swc-linux-x64-musl": "16.2.10",
    "@next/swc-win32-x64-msvc": "16.2.10",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.2",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.2",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.2",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  },
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.mjs"
  }
}
